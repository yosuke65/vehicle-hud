<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android Automotive only: read speed from the Vehicle HAL. Optional,
         so the same APK still installs and runs on a phone. -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- Only granted when the HUD is installed as a platform-signed priv-app
         in the AAOS image (vendor/yosuke/vehiclehud in the AOSP tree). Used to
         find the private instrument-cluster display and launch Unity on it.
         A normal install just doesn't get them, and the HUD falls back. -->
    <uses-permission android:name="android.car.permission.ACCESS_PRIVATE_DISPLAY_ID" />
    <uses-permission
        android:name="android.permission.INTERNAL_SYSTEM_WINDOW"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.VehicleHud">
        <uses-library android:name="android.car" android:required="false" />
        <service
            android:name=".TelemetryService"
            android:exported="false"
            android:process=":telemetry" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.VehicleHud">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- See UnityPlayerGameActivity below. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <!-- Declared in unityLibrary's own manifest; merged here only to add
             the distraction-optimized flag. On a car, CarPackageManagerService
             covers any activity on a restricted display (the driver's
             cluster) with SystemUI's ActivityBlockingActivity unless it's
             distraction-optimized, and it only trusts this declaration from
             system apps, which the priv-app install is. A real app would
             also have to meet the driver-distraction guidelines.
             Its own taskAffinity: the activity is singleTask, so with the
             app's default affinity a launch onto the cluster would reuse the
             HUD's task and could move the HUD off the center display. -->
        <activity
            android:name="com.unity3d.player.UnityPlayerGameActivity"
            android:taskAffinity="dev.yosukesakurai.vehiclehud.unity"
            tools:node="merge">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <activity
            android:name=".VulkanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"
            android:theme="@style/Theme.VehicleHud" />

        <receiver
            android:name=".ModeSwitchReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.yosukesakurai.vehiclehud.SWITCH_SECONDARY_DISPLAY" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
