# Perfetto config behind the GPU-time numbers in the README (Phase 12, Pixel 6a, 2026-10-13).
# First: adb shell setprop debug.graphics.gpu.profiler.perfetto 1
# Run:   adb push tools/gpu_trace.pbtx /data/local/tmp/
#        adb shell "cat /data/local/tmp/gpu_trace.pbtx | perfetto --txt -c - -o /data/misc/perfetto-traces/gpu.pftrace"
# gpu.renderstages registered on the Pixel 6a; gpu.counters did not.
buffers {
  size_kb: 131072
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 8192
  fill_policy: RING_BUFFER
}
# GPU work per render pass / stage, from the GPU driver's Perfetto producer.
data_sources {
  config {
    name: "gpu.renderstages"
    target_buffer: 0
  }
}
# Hardware counters (Mali), sampled every 1 ms.
data_sources {
  config {
    name: "gpu.counters"
    target_buffer: 0
    gpu_counter_config {
      counter_period_ns: 1000000
      instrumented_sampling: false
    }
  }
}
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "power/gpu_frequency"
      ftrace_events: "sched/sched_switch"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_apps: "dev.yosukesakurai.vehiclehud"
    }
  }
}
data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
    target_buffer: 1
  }
}
duration_ms: 6000
